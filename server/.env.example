# This file is copied to server/.env automatically the first time you run `npm start`.

PORT=5000

# --- Database -------------------------------------------------------------
# Leave MONGO_URI commented out and the app will use a MongoDB that is already
# running on this computer, or start a built-in one (data is kept in the .data folder).
# To use MongoDB Atlas or your own server, uncomment and set it:
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/mern_shop

# Generated for you on first run. Keep it secret; changing it logs everyone out.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Websites that may call this API from a browser (comma-separated). Only needed when the website is
# hosted somewhere else, e.g. CLIENT_URL=https://myshop.com,https://www.myshop.com — localhost always works while developing.
# CLIENT_URL=https://myshop.com

# Shown to customers at checkout for manual payments
GCASH_NAME=Your Store Name
GCASH_NUMBER=09XX XXX XXXX
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Your Store Name
BANK_ACCOUNT_NUMBER=0000 0000 0000

# Flat shipping fee, and the order total at which shipping becomes free
SHIPPING_FEE=100
FREE_SHIPPING_OVER=2000

# Timezone used to group sales by day on the dashboard
TIMEZONE=Asia/Manila
