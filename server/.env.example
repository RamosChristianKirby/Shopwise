# This file is copied to server/.env automatically the first time you run `npm start`.

PORT=5000

# --- Database -------------------------------------------------------------
# Leave MONGO_URI commented out and the app will use a MongoDB that is already
# running on this computer, or start a built-in one (data is kept in the .data folder).
# To use MongoDB Atlas or your own server, uncomment and set it:
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/mern_shop

# Generated for you on first run. Keep it secret; changing it logs everyone out.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Websites that may call this API from a browser (comma-separated). Only needed when the website is
# hosted somewhere else, e.g. CLIENT_URL=https://myshop.com,https://www.myshop.com — localhost always works while developing.
# CLIENT_URL=https://myshop.com

# Shown to customers at checkout for manual payments
GCASH_NAME=Your Store Name
GCASH_NUMBER=09XX XXX XXXX
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Your Store Name
BANK_ACCOUNT_NUMBER=0000 0000 0000

# Flat shipping fee, and the order total at which shipping becomes free
SHIPPING_FEE=100
FREE_SHIPPING_OVER=2000

# Timezone used to group sales by day on the dashboard
TIMEZONE=Asia/Manila

# --- AI shopping assistant (optional) ------------------------------------
# With a Claude API key, Pro/Business stores (and the main store) get the Claude-powered
# assistant. Without one, the built-in assistant still answers product, shipping and order questions.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- PayPal (optional) ---------------------------------------------------
# Used for the main store's checkout and for merchants paying their Shopwise plan.
# Get keys at developer.paypal.com → Apps & Credentials. Use sandbox keys while testing.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_CURRENCY=PHP

# --- Multi-store platform (SaaS) ------------------------------------------
# Name of the main store (created automatically on first start)
# STORE_NAME=Shopwise
# With PLATFORM_DOMAIN=shopwise.ph, urban-threads.shopwise.ph opens the "urban-threads" store
# (point a wildcard DNS record *.shopwise.ph at this server). Optional.
# PLATFORM_DOMAIN=
# Where merchants send plan payments (defaults to the GCASH_* / BANK_* values above)
# PLATFORM_GCASH_NAME=
# PLATFORM_GCASH_NUMBER=
# PLATFORM_BANK_NAME=
# PLATFORM_BANK_ACCOUNT_NAME=
# PLATFORM_BANK_ACCOUNT_NUMBER=
